# 推荐运行 node scripts/init-env.mjs 生成独立随机值，不直接使用占位符。
LAB_STORAGE=memory
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:3001
SESSION_SECRET=
LAB_PASSWORD=
POSTGRES_PASSWORD=
# 原生 PostgreSQL 模式才填写。使用新的隔离库，勿填已有业务库。
# DATABASE_URL=postgres://case_lab:password@127.0.0.1:5432/case_lab
# 本机HTTP教学环境为false；真正HTTPS部署需另行设计代理与cookie设置。
COOKIE_SECURE=false
